# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 大模型后端：maas | local | null =====
# maas  = 华为云 ModelArts Studio（比赛演示、线上部署）
# local = 本地 vLLM / Ollama（开源复现，需要自己起服务）
# null  = 不调用大模型，只用规则词典（零成本、可离线）
#
# 注意：本项目不内置任何密钥。使用者必须使用自己的华为云账号创建 Key，
# 由此产生的 token 费用由使用者账号承担。
LLM_BACKEND=maas

# --- 本地 OpenAI 兼容服务（LLM_BACKEND=local 时生效）---
LOCAL_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_MODEL=qwen2.5-7b-instruct
LOCAL_API_KEY=EMPTY

# --- 华为云 MaaS（LLM_BACKEND=maas 时生效）---
# 地址以控制台「OpenAI 兼容接口」为准，必须保留 /v1 结尾
MAAS_BASE_URL=https://<your-maas-endpoint>/v1
MAAS_MODEL=<model-parameter-name>
MAAS_API_KEY=<your-own-api-key>

# ===== 华为云基础服务 =====
# SIS 按音频时长计费，同样使用使用者自己的账号
HUAWEI_AK=
HUAWEI_SK=
HUAWEI_PROJECT_ID=
HUAWEI_REGION=cn-southwest-2
OBS_BUCKET=
USE_CLOUD_STORAGE=false
USE_CLOUD_ASR=false

# ===== 存储 =====
# 本地开发默认 SQLite；线上替换为华为云 RDS MySQL
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=

# ===== 模型文件 =====
MODEL_PATH=models/phq8_model.joblib
PHQ8_BINARY_THRESHOLD=10